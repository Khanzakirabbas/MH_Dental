<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - MH Dental</title>

    <!-- PWA: manifest + theme color -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#0a2c5c">
    <meta name="description" content="MH Dental - quality dental equipment and solutions you can trust.">

    <!-- Icons -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" href="~/icons/icon-192.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="MH Dental">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="top">
        <div class="top-bar">
            <a class="logo" href="~/Index" aria-label="MH Dental home">
                <img src="~/images/MHLogo.png" class="logo-img" alt="MH Dental logo">
                <div class="logo-text">
                    <div class="name">M.H. <span>DENTAL ALIGHAR</span></div>
                </div>
            </a>
            <form class="search-box" role="search" method="get">
                <input type="text" name="q" placeholder="Search dental equipment...">
                <button type="submit" aria-label="Search">&#128269;</button>
            </form>
            <div class="top-actions">
                <button type="button" id="pwa-install-icon-btn" class="action action-icon-only" aria-label="Install App" title="Install App">
                    <svg viewBox="0 0 24 24" fill="none" stroke="url(#downloadGradient)" stroke-width="1.6">
                        <defs>
                            <linearGradient id="downloadGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#1a73e8" />
                                <stop offset="100%" stop-color="#00c853" />
                            </linearGradient>
                        </defs>
                        <path d="M12 3v12m0 0l-4-4m4 4l4-4" />
                        <path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" />
                    </svg>
                </button>

                <a href="https://www.instagram.com/mhdentalaligarh/"
                   class="ig-float" target="_blank" rel="noopener" aria-label="Follow us on Instagram">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M12 2c-2.7 0-3.06.01-4.12.06-1.06.05-1.79.22-2.43.47-.66.26-1.22.6-1.77 1.16-.56.55-.9 1.11-1.16 1.77-.25.64-.42 1.37-.47 2.43C2.01 8.94 2 9.3 2 12s.01 3.06.06 4.12c.05 1.06.22 1.79.47 2.43.26.66.6 1.22 1.16 1.77.55.56 1.11.9 1.77 1.16.64.25 1.37.42 2.43.47C8.94 21.99 9.3 22 12 22s3.06-.01 4.12-.06c1.06-.05 1.79-.22 2.43-.47.66-.26 1.22-.6 1.77-1.16.56-.55.9-1.11 1.16-1.77.25-.64.42-1.37.47-2.43.05-1.06.06-1.42.06-4.12s-.01-3.06-.06-4.12c-.05-1.06-.22-1.79-.47-2.43-.26-.66-.6-1.22-1.16-1.77-.55-.56-1.11-.9-1.77-1.16-.64-.25-1.37-.42-2.43-.47C15.06 2.01 14.7 2 12 2zm0 1.8c2.67 0 2.99.01 4.04.06.97.04 1.5.2 1.85.34.47.18.8.4 1.15.75.35.35.57.68.75 1.15.14.35.3.88.34 1.85.05 1.05.06 1.37.06 4.04s-.01 2.99-.06 4.04c-.04.97-.2 1.5-.34 1.85-.18.47-.4.8-.75 1.15-.35.35-.68.57-1.15.75-.35.14-.88.3-1.85.34-1.05.05-1.37.06-4.04.06s-2.99-.01-4.04-.06c-.97-.04-1.5-.2-1.85-.34-.47-.18-.8-.4-1.15-.75-.35-.35-.57-.68-.75-1.15-.14-.35-.3-.88-.34-1.85C3.81 14.99 3.8 14.67 3.8 12s.01-2.99.06-4.04c.04-.97.2-1.5.34-1.85.18-.47.4-.8.75-1.15.35-.35.68-.57 1.15-.75.35-.14.88-.3 1.85-.34C9.01 3.81 9.33 3.8 12 3.8zm0 3.05a5.15 5.15 0 100 10.3 5.15 5.15 0 000-10.3zm0 8.5a3.35 3.35 0 110-6.7 3.35 3.35 0 010 6.7zm5.35-8.7a1.2 1.2 0 11-2.4 0 1.2 1.2 0 012.4 0z" />
                    </svg>
                </a>
                @* <a style="display:none;" class="action action-icon-only" href="#" aria-label="Request a Quote" title="Request a Quote"><svg viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.6"><path d="M9 5h11l-1.5 8h-9L7 3H3" /><circle cx="10" cy="20" r="1.3" /><circle cx="17" cy="20" r="1.3" /></svg></a> *@
                @* <div class="action"><svg viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.6"><circle cx="12" cy="8" r="3.5" /><path d="M5 20c1.5-4 5-6 7-6s5.5 2 7 6" /></svg></div> *@
                @* <div class="action cart-badge"><svg viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.6"><circle cx="9" cy="21" r="1" /><circle cx="18" cy="21" r="1" /><path d="M2 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 7H6" /></svg><span class="count">0</span></div> *@
            </div>
            @* <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
                <span></span><span></span><span></span>
            </button> *@
        </div>
        <nav class="main-nav" style="display:none;">
            <ul id="main-nav-list">
                <li class="active"><a href="~/Index">Home</a></li>
                <li><a href="#">Products &#9662;</a></li>
                <li><a href="#">Brands</a></li>
                <li><a href="#">Events</a></li>
                <li><a href="#">About Us</a></li>
                @* <li><a href="#">Blog</a></li> *@
                <li><a href="#">Contact Us</a></li>
            </ul>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="footer-grid">
            <div>
                <div class="footer-brand">
                    <svg width="30" height="30" viewBox="0 0 64 64" fill="none" stroke="#fff" stroke-width="3"><path d="M32 8c-6 0-9 4-14 4-6 0-10-4-10 6 0 10 4 14 6 24 1.5 7 4 12 8 12 5 0 4-10 10-10s5 10 10 10c4 0 6.5-5 8-12 2-10 6-14 6-24 0-10-4-6-10-6-5 0-8-4-14-4z" /></svg>
                    <div><div class="name">MH Dental Alighar</div></div>
                </div>
                <p>Premium Dental Equipment For Modern Practices That Demand Excellence</p>
               @*  <div class="socials">
                    <a href="#" aria-label="Facebook">f</a>
                    <a href="#" aria-label="Instagram">&#128247;</a>
                    <a href="#" aria-label="LinkedIn">in</a>
                    <a href="#" aria-label="YouTube">&#9658;</a>
                </div> *@
            </div>
            @* <div>
      <h4>Quick Links</h4>
      <ul>
        <li><a href="~/Index">Home</a></li>
        <li><a href="#">About Us</a></li>
        <li><a href="#">Products</a></li>
        <li><a href="#">Brands</a></li>
        <li><a href="#">Events</a></li>
        <li><a href="#">Blog</a></li>
        <li><a href="#">Contact Us</a></li>
      </ul>
    </div> *@
            <div>
                <h4>Customer Service</h4>
                <ul>
                    <li><a href="#">Installation</a></li>
                    <li><a href="#">Warranty Support</a></li>
                    <li><a href="#">Product Demonstration</a></li>
                    <li><a href="#">Warranty</a></li>
                    <li><a href="#">Repair & Maintenance</a></li>
                    <li><a href="#">AMC Services</a></li>
                </ul>
            </div>
            <div id="Add" style="margin-left: auto;">
                <h4>Contact Us</h4>
                <div class="contact-item"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>12-14, Tarana Palace Zakariya Market Medical Road, Aligarh :- 202001, Uttar Pradesh.</div>
                <div class="contact-item"><svg viewBox="0 0 24 24"><path d="M4 5c0 8 7 15 15 15l3-4-6-2-2 2c-2-1-4-3-5-5l2-2-2-6z" /></svg>(+91) 9536982340 / 9598069169</div>
                @* <div class="contact-item"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 6l9 7 9-7"/></svg>info@mhdental.in</div> *@
                <div class="contact-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" /></svg>https://mh-dental.onrender.com</div>
            </div>
        </div>
        <div class="footer-bottom">
            <div>&copy; @DateTime.Now.Year MH Dental Alighar. All Rights Reserved.</div>
            @* <div>Designed &amp; Developed by ZackTech</div> *@
        </div>
    </footer>

    <div class="wa-float">
        <a href="https://wa.me/919598069169?text=Hi%2C%20I%20have%20an%20inquiry%20about%20MH%20Dental%20products."
           class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.6 14.3c-.2.6-1.3 1.2-1.9 1.3-.5.1-1.1.2-3.6-.8-3-1.2-5-4.2-5.1-4.4-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1-2.5.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5.2.6.7 1.9.8 2 .1.2.1.4 0 .6-.1.2-.2.3-.4.5-.2.2-.4.4-.5.6-.2.2-.4.4-.2.7.2.3 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.9.3.1.5.1.7-.1.2-.2.8-.9 1-1.2.2-.3.4-.3.7-.2.3.1 1.8.8 2.1 1 .3.1.5.2.6.3.1.2.1.9-.1 1.5z" /></svg>
        </a>
    </div>

    <!-- Install banner (shown by site.js when the app is installable) -->
    <div id="pwa-install-banner" class="pwa-install-banner">
        <span>Install the MH Dental app for faster access.</span>
        <button id="pwa-install-btn">Install</button>
        <button id="pwa-dismiss-btn" aria-label="Dismiss">&times;</button>
    </div>

    <!-- Install confirmation modal (opened from the header Install icon) -->
    <div id="pwa-confirm-overlay" class="pwa-confirm-overlay">
        <div class="pwa-confirm-box" role="dialog" aria-modal="true" aria-labelledby="pwa-confirm-title">
            <h3 id="pwa-confirm-title">Install MH Dental?</h3>
            <p>Add the MH Dental app to your device for faster access, offline browsing, and a full-screen experience without the browser bar.</p>
            <div class="pwa-confirm-actions">
                <button id="pwa-confirm-cancel" class="btn-outline">Cancel</button>
                <button id="pwa-confirm-install" class="btn-solid">Install</button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
