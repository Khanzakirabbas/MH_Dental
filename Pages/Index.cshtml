<section class="our-partners">
    <div class="container text-center">
        <div class="section-title"><h2>Dealership Brands</h2></div>
        @* <h2 class="section-title">Our Partners</h2> *@
        <img src="~/images/FB.png"
             alt="Our Partner Brands"
             class="img-fluid" />
    </div>
</section>

