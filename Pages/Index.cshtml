    <div class="service-item"><div class="service-icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" /></svg></div><div><div class="stitle">Product Demonstration</div><div class="sdesc">Live demo &amp; product training</div></div></div>
    <div class="service-item"><div class="service-icon"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6z" /><path d="M9 12l2 2 4-4" /></svg></div><div><div class="stitle">Warranty Support</div><div class="sdesc">Genuine warranty on all products</div></div></div>
    <div class="service-item"><div class="service-icon"><svg viewBox="0 0 24 24"><path d="M14 7l3 3-8 8H6v-3z" /><path d="M13 4l3 3" /></svg></div><div><div class="stitle">Repair &amp; Maintenance</div><div class="sdesc">Quick repair &amp; maintenance services</div></div></div>
    <div class="service-item"><div class="service-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l3 2" /></svg></div><div><div class="stitle">AMC Services</div><div class="sdesc">Annual maintenance contracts available</div></div></div>
</div>

<div class="section-title"><h2>What Our Customers Say</h2></div>
<div class="testimonial-slider container" data-testimonial-slider>
    <div class="testimonial-track">
        @foreach (var t in Model.Testimonials)
        {
            var photoUrl = Url.Content(t.PhotoUrl);
            <div class="testimonial-slide">
                <div class="testimonial-card">
                    <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                    <p>"@t.Quote"</p>
                    <div class="reviewer">
                        <div class="avatar"><img src="@photoUrl" alt="@t.Name" data-fallback-label="@t.Name"></div>
                        <div><div class="rname">@t.Name</div><div class="rclinic">@t.Clinic</div></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="dots-row" data-testimonial-dots></div>
</div>

