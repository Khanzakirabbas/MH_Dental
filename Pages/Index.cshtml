@page
@model MHDental.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-events">
        <h4>&#128197; Upcoming Events</h4>
        @foreach (var e in Model.UpcomingEvents)
        {
            var eventImgUrl = Url.Content(e.ImageUrl);
            <div class="event-item">
                <img class="event-thumb" src="@eventImgUrl" alt="@e.Title" loading="lazy" data-fallback-label="@e.Title">
                <div class="event-date"><span class="mon">@e.Month</span>@e.Day</div>
                <div class="event-info"><div class="etitle">@e.Title</div><div class="eloc">@e.Location</div></div>
            </div>
        }
        <a class="btn-solid" href="#" style="margin-top:4px;">View All Events</a>
    </div>
    <div class="hero-image" data-hero-slider>
        @for (int i = 0; i < Model.HeroSlides.Count; i++)
        {
            var s = Model.HeroSlides[i];
            var slideClass = i == 0 ? "hero-slide active" : "hero-slide";
            var loadingMode = i == 0 ? "eager" : "lazy";
            var resolvedUrl = Url.Content(s.ImageUrl);
            <img class="@slideClass" src="@resolvedUrl" alt="@s.Alt" loading="@loadingMode" data-fallback-label="@s.Alt">
        }
        <div class="booth-overlay"></div>
        <button class="hero-arrow left" aria-label="Previous slide">&#8249;</button>
        <div class="booth-logo">
            @* <div class="name">MH <span>Dental</span></div>
            <div class="tag">Quality You Can Trust</div> *@
        </div>
        <button class="hero-arrow right" aria-label="Next slide">&#8250;</button>
        <div class="hero-dots">
            @for (int i = 0; i < Model.HeroSlides.Count; i++)
            {
                var dotClass = i == 0 ? "active" : "";
                <span class="@dotClass" data-index="@i"></span>
            }
        </div>
    </div>
</section>

<div class="section-title"><h2>Shop By Category</h2></div>
<div class="slider-section">
    <div class="slider-wrap">
        <button class="slider-arrow prev" aria-label="Scroll categories left">&#8249;</button>
        <div class="slider-track" data-slider>
            @foreach (var c in Model.Categories)
            {
                var catImgUrl = Url.Content(c.ImageUrl);
                <div class="cat-card">
                    <div class="cat-thumb"><img src="@catImgUrl" alt="@c.Name" loading="lazy" data-fallback-label="@c.Name"></div>
                    <div class="label">@c.Name</div>
                </div>
            }
        </div>
        <button class="slider-arrow next" aria-label="Scroll categories right">&#8250;</button>
    </div>
</div>


<div class="section-title"><h2>Hot Selling Products</h2></div>
@* <div class="section-head-row container">
    <a class="view-all" href="#">View All Products &#8594;</a>
    <h2>Hot Products</h2>
    <span class="section-head-spacer"></span>
</div> *@
<div class="slider-section">
    <div class="slider-wrap">
        <button class="slider-arrow prev" aria-label="Scroll products left">&#8249;</button>
        <div class="slider-track" data-slider>
            @foreach (var p in Model.HotProducts)
            {
                var productImgUrl = Url.Content(p.ImageUrl);
                var waMessage = Uri.EscapeDataString($"Hi, I'm interested in this product:\n\n{p.Name}\n\nCan you share more details?");
                var waLink = $"https://wa.me/919598069169?text={waMessage}";
                <div class="product-card">
                    <div class="product-thumb"><img src="@productImgUrl" alt="@p.Name" loading="lazy" data-fallback-label="@p.Name"></div>
                    <div class="product-info">
                        <div class="pname">@p.Name</div>
                        <div class="price">@p.Price</div>
                        <a class="btn-outline" href="@waLink" target="_blank" rel="noopener">Ask for details</a>
                    </div>
                </div>
            }
        </div>
        <button class="slider-arrow next" aria-label="Scroll products right">&#8250;</button>
    </div>
</div>

<div class="promo-strip">
    <div class="promo-card promo-offer">
        <div class="promo-text">
            <span class="promo-badge">SPECIAL OFFER</span>
            <h3>Up to 15% OFF</h3>
            <p class="promo-sub">On Selected Dental Equipment</p>
            <button class="btn-solid" style="margin-top:8px;">Shop Now</button>
        </div>
        <img class="promo-img" src="https://images.pexels.com/photos/6812478/pexels-photo-6812478.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&fit=crop" alt="Dental equipment on offer" loading="lazy" data-fallback-label="Special Offer">
    </div>
    <div class="promo-card promo-offer promo-offer-alt">
        <div class="promo-text">
            <span class="promo-badge promo-badge-alt">LIMITED TIME</span>
            <h3>Up to 25% OFF</h3>
            <p class="promo-sub">On Autoclaves &amp; Sterilizers</p>
            <button class="btn-solid btn-green" style="margin-top:8px;">Shop Now</button>
        </div>
        <img class="promo-img" src="https://images.pexels.com/photos/6627665/pexels-photo-6627665.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&fit=crop" alt="Autoclave and sterilizer offer" loading="lazy" data-fallback-label="Limited Time Offer">
    </div>
</div>

